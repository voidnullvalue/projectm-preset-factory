{
  "name": "projectm-preset-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Unattended Codex + GitHub preset generation pipeline for projectM",
  "scripts": {
    "lint-batch": "node tools/lint_preset.js",
    "score-batch": "node tools/score_static.js",
    "dedupe-batch": "node tools/dedupe.js",
    "select-final": "node tools/select_final_500.js",
    "generate-batch": "node tools/generate_batch.js",
    "run-batch": "bash tools/batch_runner.sh",
    "sources:fetch": "node tools/fetch_sources.js",
    "sources:unpack": "node tools/unpack_sources.js",
    "sources:normalize": "node tools/normalize_sources.js",
    "sources:dedupe": "node tools/dedupe_sources.js",
    "sources:index": "node tools/index_sources.js",
    "sources:catalog": "node tools/catalog_sources.js",
    "sources:build": "npm run sources:unpack && npm run sources:normalize && npm run sources:dedupe && npm run sources:index && npm run sources:catalog"
  }
}
